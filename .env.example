BOT_TOKEN=replace_with_botfather_token
# Optional separate bot for admin copies; if blank, BOT_TOKEN is used.
ADMIN_BOT_TOKEN=
DATABASE_URL=postgresql://user:password@localhost:5432/whisper

# The admin must start the selected admin-copy bot in Telegram first.
# Use the admin's numeric personal Telegram user ID.
ADMIN_CHAT_ID=replace_with_admin_telegram_user_id
ADMIN_USER_IDS=replace_with_admin_telegram_user_id

# rollback prevents publication unless the admin copy was delivered.
# continue publishes the whisper after logging a failed admin-copy attempt.
ADMIN_COPY_FAILURE_POLICY=rollback

# Whisper secrets are erased from active storage when revealed.
WHISPER_MAX_LENGTH=2000
